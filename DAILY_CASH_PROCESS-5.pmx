        <dyn_type>xmlform</dyn_type>
        <dyn_filename><![CDATA[9759457026a44c42cec1fe2023904157/2134194666a475b433c0473040955045]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"BM APPROVAL","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"2134194666a475b433c0473040955045","name":"BM APPROVAL","description":"","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"form","variable":"","var_uid":"","dataType":"","id":"9574395186a44c87a460366066727960","name":"FORMS DAILY CASH","description":"","mode":"view","script":{"type":"js","code":"// On attend que le formulaire soit complètement chargé\nvar calculerTotal = function() {\n    // Utilisation de || 0 pour éviter le NaN si un champ est vide\n    var depSaving    = parseFloat($('#depSaving').getValue()) || 0;\n    var withdrawBank = parseFloat($('#withdrawBank').getValue()) || 0;\n    var otherEntries = parseFloat($('#otherEntries').getValue()) || 0;\n    var forexFd      = parseFloat($('#forexFd').getValue()) || 0;\n    var clickFd      = parseFloat($('#clickFd').getValue()) || 0;\n    var imtFd        = parseFloat($('#imtFd').getValue()) || 0;\n    var depMpesa     = parseFloat($('#depMpesa').getValue()) || 0;\n    \n    // Calcul de la somme\n    var total = depSaving + withdrawBank + otherEntries + forexFd + clickFd + imtFd + depMpesa;\n    console.log(\"calculerTotal: \", total)\n    // Attribution de la valeur au champ cible\n    $('#totalReceipts').setValue(total);\n \tconst totalWithdrw = parseFloat($('#totalWithdrawals').getValue()) || 0;\n    const openingBal = parseFloat($(\"#openBal\").getValue()) || 0;\n  \t$('#closingBal').setValue(openingBal + total - totalWithdrw);\n};\n\nvar estDeviseCDF = function() {\n    var devise = $('#currencyFld').getValue();\n    return devise && String(devise).toUpperCase() === 'CDF';\n};\n\nvar toggleRecapFields = function() {\n    var masquer = estDeviseCDF();\n    var champsRecap = ['#recapSE', '#recapVB', '#recapIL'];\n\n    champsRecap.forEach(function(selecteur) {\n        var $champ = $(selecteur);\n        var $container = $champ.closest('.pmdynaform-field, .form-group');\n        if ($container.length === 0) {\n            $container = $champ.parent();\n        }\n        if (masquer) {\n            $champ.setValue(0);\n            $container.hide();\n        } else {\n            $container.show();\n        }\n    });\n\n    if (masquer) {\n        calculerTotalSortie();\n    }\n};\n\nvar calculerTotalSortie = function() {\n    // Utilisation de || 0 pour éviter le NaN si un champ est vide\n    var recapSE    = estDeviseCDF() ? 0 : (parseFloat($('#recapSE').getValue()) || 0);\n    var recapVB = estDeviseCDF() ? 0 : (parseFloat($('#recapVB').getValue()) || 0);\n    var recapIL = estDeviseCDF() ? 0 : (parseFloat($('#recapIL').getValue()) || 0);\n    var withSavings      = parseFloat($('#withSavings').getValue()) || 0;\n    var otherExp      = parseFloat($('#otherExp').getValue()) || 0;\n    var outClick        = parseFloat($('#outClick').getValue()) || 0;\n    var imtSortie        = parseFloat($('#imtSortie').getValue()) || 0;\n    var depBank     = parseFloat($('#depBank').getValue()) || 0;\n  \tvar manqBank     = parseFloat($('#manqBank').getValue()) || 0;\n \tvar imtRecp     = parseFloat($('#imtRecp').getValue()) || 0;\n  \tvar forexRecp     = parseFloat($('#forexRecp').getValue()) || 0;\n  \tvar withMpesa     = parseFloat($('#withMpesa').getValue()) || 0;\n    \n    // Calcul de la somme\n    var total = recapSE + recapVB + recapIL + withSavings + otherExp + outClick + imtSortie + depBank + manqBank + imtRecp + forexRecp + withMpesa;\n    console.log(\"calculerTotalSortie: \", total)\n    // Attribution de la valeur au champ cible\n    $('#totalWithdrawals').setValue(total);\n  \tconst totalReceipts = parseFloat($('#totalReceipts').getValue()) || 0;\n    const openingBal = parseFloat($(\"#openBal\").getValue()) || 0;\n  \t$('#closingBal').setValue(openingBal + totalReceipts - total);\n};\n\n\n$(\"#9574395186a44c87a460366066727960\").on(\"submit\", function(e){\n\te.preventDefault();\n  \tcalculerTotal();\n    calculerTotalSortie();\n  \tthis.submit();\n});\n\n\n\nvar findGlBalance = function(){\n  $(\"#openBal\").setValue(0);\n  const selectedCurrency = $('#currencyFld').getValue();\n  const selectedBranch = $('#selectedBranch').getValue();\n  const dateSubm = $('#dateSubm').getValue();\n  if(!dateSubm) return;\n  const apiUrl = \"http://10.64.38.125:5000/gl-balance/1-\" + selectedBranch + \"-000-200-1010007570?currency=\" + selectedCurrency + \"&balance_dt=\" + dateSubm;\n  //console.log(\"findGlBalance: \" + apiUrl)\n  alert(\"Balance d'ouverture en cours de chargement...\");\n  $.ajax({\n  \turl: apiUrl,\n    type: 'GET',\n    dataType: 'json',\n    success: function(response){\n    \t$(\"#openBal\").setValue(Math.abs(parseFloat(response.Balance)));\n    }\n  });\n}\nvar onCurrencyChange = function() {\n    toggleRecapFields();\n    findGlBalance();\n};\n\n$(\"#dateSubm\").setOnchange(findGlBalance);\n$(\"#selectedBranch\").setOnchange(findGlBalance);\n$(\"#currencyFld\").setOnchange(onCurrencyChange);\n\n// Liaison de l'événement 'change' sur tous les champs concernés\n$('#depSaving').setOnchange(calculerTotal);\n$('#withdrawBank').setOnchange(calculerTotal);\n$('#otherEntries').setOnchange(calculerTotal);\n$('#forexFd').setOnchange(calculerTotal);\n$('#clickFd').setOnchange(calculerTotal);\n$('#clickFd').setOnchange(calculerTotal);\n$('#imtFd').setOnchange(calculerTotal);\n$('#depMpesa').setOnchange(calculerTotal);\n\n\n//Liaison des sorties\n$('#recapSE').setOnchange(calculerTotalSortie);\n$('#recapVB').setOnchange(calculerTotalSortie);\n$('#recapIL').setOnchange(calculerTotalSortie);\n$('#withSavings').setOnchange(calculerTotalSortie);\n$('#otherExp').setOnchange(calculerTotalSortie);\n$('#outClick').setOnchange(calculerTotalSortie);\n$('#imtSortie').setOnchange(calculerTotalSortie);\n$('#depBank').setOnchange(calculerTotalSortie);\n$('#manqBank').setOnchange(calculerTotalSortie);\n$('#imtRecp').setOnchange(calculerTotalSortie);\n$('#forexRecp').setOnchange(calculerTotalSortie);\n$('#withMpesa').setOnchange(calculerTotalSortie);\n\n$(document).ready(function() {\n    toggleRecapFields();\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"FORMS DAILY CASH REPORT","colSpan":12}],[{"type":"text","variable":"openBal","var_uid":"8510159456a44ca0493b984036374559","dataType":"string","protectedValue":false,"id":"openBal","name":"openBal","label":"Balance Ouverture","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"openBal","colSpan":4},{"type":"dropdown","variable":"selectedBranch","var_uid":"8609448486a44ca4e8b4847031848829","dataType":"string","protectedValue":false,"id":"selectedBranch","name":"selectedBranch","label":"Branche","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"101","label":"GOMBE"},{"value":"102","label":"MASINA"},{"value":"103","label":"MATADI"},{"value":"104","label":"LUBUMBASHI"},{"value":"105","label":"UPN"},{"value":"106","label":"BOMA"},{"value":"107","label":"VICTOIRE"},{"value":"108","label":"NGABA"},{"value":"109","label":"KATUBA"},{"value":"110","label":"LIKASI"}],"var_name":"selectedBranch","colSpan":4},{"type":"dropdown","variable":"currencyFld","var_uid":"7090544196a44d38b93fd71081070117","dataType":"string","protectedValue":false,"id":"currencyFld","name":"currencyFld","label":"Devise","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"USD","label":"Dollars américains (USD)"},{"value":"CDF","label":"Franc Congolais"}],"var_name":"currencyFld","colSpan":4}],[{"type":"datetime","variable":"dateSubm","var_uid":"6863208186a44e3858b95f4094574796","dataType":"datetime","protectedValue":false,"id":"dateSubm","name":"dateSubm","label":"Date Soumission","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"dateSubm","colSpan":4},{"colSpan":4},{"colSpan":4}],[{"type":"subtitle","id":"subtitle0000000001","label":"ENTREES","colSpan":12}],[{"type":"text","variable":"depSaving","var_uid":"4063009376a44cb64c23fc1034701046","dataType":"string","protectedValue":false,"id":"depSaving","name":"depSaving","label":" Deposit savings & Collections","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"depSaving","colSpan":4},{"type":"text","variable":"withdrawBank","var_uid":"1757630616